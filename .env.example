# SecureGate Environment Variables
# Copy this file to .env.local and fill in real values.

# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/securegate"

# NextAuth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# The public URL of your app (no trailing slash)
# Used for redirect URLs in middleware and email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP configuration for sending transactional emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="auth@yourdomain.com"
