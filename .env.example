# SecureGate Environment Variables
# Copy this file to .env.local and fill in real values.

# PostgreSQL connection strings for Prisma (via Supabase)
# Get these from your Supabase project → Project Settings → Database

# Pooled connection (PgBouncer) — used at runtime by Prisma Client
# Port 6543 with ?pgbouncer=true for PgBouncer compatibility
# Format: postgresql://project.user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used by Prisma Migrate and prisma db push
# Port 5432, bypasses PgBouncer to support prepared statements
# Format: postgresql://project.user:password@aws-0-region.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:5432/postgres"

# NextAuth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# The public URL of your app (no trailing slash)
# Used for redirect URLs in middleware and email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP configuration for sending transactional emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="auth@yourdomain.com"
